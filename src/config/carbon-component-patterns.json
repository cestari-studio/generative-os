  "tokenFallback": {
    "comment": "Token parameterization coverage: product CSS consumes --genos-* aliases (src/styles/_genos-brand-tokens.scss); every alias falls back to the official --cds-* Carbon token in both white and g100 when no authorized override exists. Overrides flow only through src/brand/brand-manifest.json (validated, no injection) and the tenant cascade — never inline.",
    "layers": [
      "Layer 0: official --cds-* Carbon tokens (white + g100)",
      "Layer 1: --genos-* semantic aliases -> Carbon tokens (default, this registry's fallback guarantee)",
      "Layer 2: authorized brand overrides (brand-manifest.json, validated)",
      "Layer 3: tenant/person cascade preferences (locked by org policy, server-confirmed)"
    ],
    "fallbackGuarantee": "An absent/invalid override at any layer resolves to the official Carbon token, so the UI never loses color/contrast in either theme."
  }
}
