      "scope": "core",
      "storybookPath": "/?path=/story/components-button--default",
      "defaultVariant": "default",
      "variants": [
        "default",
        "secondary",
        "tertiary",
        "ghost",
        "danger",
        "danger-tertiary",
        "danger-ghost",
        "icon-button",
        "icon-button-with-badge",
        "skeleton"
