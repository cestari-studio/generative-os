{
  "name": "generative-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.0",
  "type": "module",
  "author": "cestari-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/cestari-studio/generative-os.git"
  },
  "scripts": {
    "dev": "node src/server",
    "build": "cross-env NODE_ENV=production npm run build:client && npm run build:server",
    "build:client": "cross-env NODE_ENV=production vite build --ssrManifest .vite/ssr-manifest.json  --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production vite build --ssr src/entry-server.jsx --outDir dist/server",
    "lighthouse": "npm run build && lsof -ti:5299 | xargs kill -9 2>/dev/null; PORT=5299 npm run preview:prod & npx --yes wait-on http://localhost:5299 --timeout 30000 && unlighthouse-ci --site http://localhost:5299; kill %1 2>/dev/null",
    "lint": "npm run lint:es && npm run lint:style && npm run format:check && npm run lint:spell",
    "lint-fix": "npm run lint:es -- --fix && npm run lint:style -- --fix && npm run format:fix",
    "lint:es": "eslint . --report-unused-disable-directives --max-warnings 0 --cache --cache-location \"node_modules/.cache/eslint/\"",
    "lint:style": "stylelint \"./**/*.scss\" --cache --cache-location \"node_modules/.cache/stylelint/\"",
    "format:check": "prettier . --check --ignore-unknown --no-error-on-unmatched-pattern --log-level warn --cache --cache-location \"node_modules/.cache/prettier/\"",
    "format:fix": "prettier . --write --ignore-unknown --no-error-on-unmatched-pattern --log-level warn --cache --cache-location \"node_modules/.cache/prettier/\"",
    "lint:spell": "cspell lint --quiet \"**\"",
    "check:branding": "node scripts/check-product-branding.mjs",
    "copyright:check": "./scripts/check-all-copyrights.sh",
    "copyright:fix": "./scripts/check-all-copyrights.sh --fix",
    "preview:prod": "cross-env NODE_ENV=production node src/server.js",
    "preview": "cross-env NODE_ENV=local node src/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "prepare": "husky",
    "scss:generate": "node scripts/generate-carbon-scss.js",
    "i18n:sync": "node scripts/i18n-sync.js",
    "semantic-release": "semantic-release",
    "test:billing-sql": "./scripts/test-billing-sql.sh",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "check:matrices": "node scripts/validate-matrices.mjs",
    "test:browser-smoke": "node scripts/browser-smoke.mjs",
    "test:axe": "node scripts/axe-a11y.mjs",
    "test:benchmark": "node scripts/benchmark.mjs",
    "test:workspace-sql": "./scripts/test-workspace-sql.sh",
    "test:notifications-sql": "./scripts/test-notifications-sql.sh",
    "test:phase2-sql": "./scripts/test-phase2-sql-ci.sh",
    "test:org-hierarchy-sql": "./scripts/test-org-hierarchy-sql.sh",
    "test:journey-ledger-sql": "./scripts/test-journey-ledger-sql.sh",
    "test:pagbank-grants-sql": "./scripts/test-pagbank-grants-sql.sh",
    "test:rpc-grants-sql": "./scripts/test-rpc-grants-sql.sh",
    "test:provision-tenant-sql": "./scripts/test-provision-tenant-sql.sh",
    "test:onboarding-delegation-sql": "./scripts/test-onboarding-delegation-sql.sh",
    "test:provision-adversarial-sql": "./scripts/test-provision-adversarial-sql.sh",
    "test:readiness-blocked-sql": "./scripts/test-readiness-blocked-sql.sh",
    "test:readiness-concurrency-race": "./scripts/test-readiness-concurrency-race.sh",
    "test:red-team-p1-sql": "./scripts/test-red-team-p1-sql.sh",
    "test:readiness-org-scoping-sql": "./scripts/test-readiness-org-scoping-sql.sh",
    "test:p2-time-state-sql": "./scripts/test-p2-time-state-sql.sh",
    "test:legacy-corporate-restrict-sql": "./scripts/test-legacy-corporate-restrict-sql.sh",
    "check:rpc-grant-exposure": "node scripts/check-rpc-grant-exposure.mjs",
    "check:carbon-patterns": "node scripts/carbon-pattern-conformance.mjs",
    "carbon:patterns": "node scripts/carbon-pattern-conformance.mjs",
    "carbon:patterns:regen": "node scripts/regen-carbon-patterns.mjs",
    "registry:sync": "node scripts/generate-registry-allowlist-sql.mjs",
    "registry:check": "node scripts/generate-registry-allowlist-sql.mjs --check",
    "spec:validate": "node scripts/spec-validate.mjs",
    "spec:generate": "node scripts/spec-generate.mjs",
    "spec:check": "node scripts/spec-generate.mjs --check",
    "spec:evidence": "node scripts/evidence-record.mjs"
  },
  "dependencies": {
    "@carbon-labs/react-theme-settings": "^0.30.0",
    "@carbon-labs/react-ui-shell": "^0.106.0",
    "@carbon/charts": "^1.27.21",
    "@carbon/charts-react": "^1.27.21",
    "@carbon/ibm-products": "^2.74.0",
    "@carbon/pictograms-react": "^11.113.0",
    "@carbon/react": "^1.73.0",
    "@ibm/plex": "^6.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "classnames": "^2.5.1",
    "compression": "^1.7.5",
    "express": "^5.0.1",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.8.1",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "react-is": "^19.0.0",
    "react-router": "^8.0.1",
    "sirv": "^3.0.0"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@double-great/stylelint-a11y": "^3.0.4",
    "@eslint/js": "^9.21.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.14.0",
    "baseline-browser-mapping": "^2.9.12",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cross-env": "^10.0.0",
    "cspell": "^10.0.0",
    "detect-port": "^2.1.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "i18next-parser": "^9.0.2",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.0.0",
    "msw": "^3.0.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.85.1",
    "semantic-release": "^25.0.5",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-plugin-carbon-tokens": "^5.0.0",
    "stylelint-use-logical": "^2.1.3",
    "unlighthouse": "^0.18.0",
    "vite": "^8.0.0",
    "vite-plugin-i18next-loader": "^4.0.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,scss,css,html,yml,yaml}": [
      "node scripts/check-copyright.js --fix",
      "git add",
      "npm run lint"
    ]
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "basic-ftp": "^6.0.1",
    "get-uri": "^8.0.0",
    "pac-proxy-agent": "^9.0.1",
    "proxy-agent": "^8.0.1",
    "qs": "^6.16.0",
    "tmp": "^0.2.6",
    "uuid": "^14.0.0"
  }
}
